# .env — IndustrySphere AI Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ─── AI APIs ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_KEY_HERE

# ─── Local Ollama ─────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─── PostgreSQL + TimescaleDB ─────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=industryphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/industryphere

# ─── Redis ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── Neo4j ────────────────────────────────────────
NEO4J_URI=neo4j+s://YOUR_AURA_INSTANCE.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password

# ─── MinIO ────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=industryphere-files

# ─── Notifications ────────────────────────────────
SSLCOMMERZ_SMS_API_KEY=your_sslcommerz_key
WATI_API_TOKEN=your_wati_token
WATI_BASE_URL=https://live-mt-server.wati.io
SENDGRID_API_KEY=SG.your_sendgrid_key
SENDGRID_FROM_EMAIL=noreply@industryphere.ai

# ─── JWT Auth ─────────────────────────────────────
JWT_SECRET_KEY=your_super_secret_jwt_key_here_make_it_long
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ─── App Config ───────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# ─── Airflow ──────────────────────────────────────
AIRFLOW__CORE__EXECUTOR=LocalExecutor
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql://postgres:your_password_here@localhost:5432/airflow

# ─── MLflow ───────────────────────────────────────
MLFLOW_TRACKING_URI=http://localhost:5000

# ─── Cloudflare Tunnel ────────────────────────────
CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
